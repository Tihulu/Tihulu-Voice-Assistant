# Bytecode and build output never belong in the repository: they collide
# add/add between branches, and they change with every interpreter build.
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/
.release-work/

# workspace tooling (carried from PR #19)
# Build and packaging artefacts never belong in the repository.
.tox/
.venv/
